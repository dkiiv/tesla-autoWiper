FLASH_PORT=/dev/ttyUSB0
# esp32c6 = production module (default), esp32p4 = bench board
IDF_TARGET=esp32c6
# CAN bitrate in kbit/s (REQUIRED for ./idf.sh build, no default).
# 500 is EXPECTED for the car but UNCONFIRMED: measure before installing.
# CAN_BITRATE_KBPS=500
# 1 = listen-only sniffer firmware (ROADMAP Phase 3.1; connect in parallel,
# never inline).  Variables set on the command line win over this file.
#SNIFFER=0
